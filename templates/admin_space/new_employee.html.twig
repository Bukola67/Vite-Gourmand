{% extends 'base.html.twig' %}

{% block title %}Créer un employé{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Créer un compte employé</h1>

    {{ form_start(employeeForm) }}
        {{ form_row(employeeForm.firstName) }}
        {{ form_row(employeeForm.lastName) }}
        {{ form_row(employeeForm.email) }}
        {{ form_row(employeeForm.phone) }}
        {{ form_row(employeeForm.plainPassword) }}

        <button type="submit" class="btn btn-primary">Créer le compte</button>
    {{ form_end(employeeForm) }}
</div>
{% endblock %}
