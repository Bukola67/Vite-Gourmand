{% extends 'base.html.twig' %}

{% block title %}{{ menu.title }} - Vite & Gourmand{% endblock %}

{% block body %}
    {% set menuImage = 'images/menus/menu-evenement.jpg' %}

    {% if menu.theme == 'Noël' %}
        {% set menuImage = 'images/menus/menu-noel.jpg' %}
    {% elseif menu.theme == 'Pâques' %}
        {% set menuImage = 'images/menus/menu-paques.jpg' %}
    {% elseif menu.theme == 'Événement' %}
        {% set menuImage = 'images/menus/menu-evenement.jpg' %}
    {% endif %}

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <a href="{{ path('app_menu') }}" class="btn btn-outline-secondary mb-4">Retour aux menus</a>

            <div class="card shadow-sm">
                <img src="{{ asset(menuImage) }}" class="card-img-top" alt="{{ menu.title }}">

                <div class="card-body">
                    <h1 class="mb-3">{{ menu.title }}</h1>
                    <p class="lead">{{ menu.description }}</p>

                    <hr>

                    <p><strong>Thème :</strong> {{ menu.theme ?: 'Non renseigné' }}</p>
                    <p><strong>Prix minimum :</strong> {{ menu.basePrice }} €</p>
                    <p><strong>Nombre minimum de personnes :</strong> {{ menu.minimumPersons }}</p>
                    <p><strong>Régime :</strong> {{ menu.diet ?: 'Non renseigné' }}</p>
                    <p><strong>Conditions :</strong> {{ menu.conditionText ?: 'Non renseignées' }}</p>
                    <p><strong>Stock disponible :</strong> {{ menu.stockAvailable ?? 'Non renseigné' }}</p>

                    <h2 class="mt-4">Plats inclus</h2>

                    {% if menu.dishes|length > 0 %}
                        <div class="list-group mb-4">
                            {% for dish in menu.dishes %}
                                <div class="list-group-item">
                                    <h3 class="h6 mb-1">{{ dish.name }}</h3>
                                    <p class="mb-1">
                                        <strong>Type :</strong> {{ dish.type }}
                                    </p>

                                    {% if dish.description %}
                                        <p class="mb-1">{{ dish.description }}</p>
                                    {% endif %}

                                    <p class="mb-0">
                                        <strong>Allergènes :</strong>
                                        {% if dish.allergens|length > 0 %}
                                            {% for allergen in dish.allergens %}
                                                {{ allergen.name }}{% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        {% else %}
                                            Aucun allergène renseigné
                                        {% endif %}
                                    </p>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">Aucun plat n’est associé à ce menu.</div>
                    {% endif %}

                    <a href="{{ path('app_order_new', {'id': menu.id}) }}" class="btn btn-primary">
                        Commander
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}