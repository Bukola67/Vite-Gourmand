{% extends 'base.html.twig' %}
{% block title %}{{ menu.title }} — Vite & Gourmand{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/order-workflow.css') }}">
{% endblock %}
{% block body %}
    {% set menuImage = 'images/menus/menu-evenement.jpg' %}

    {% if menu.theme == 'Noël' %}
        {% set menuImage = 'images/menus/menu-noel.jpg' %}
    {% elseif menu.theme == 'Pâques' %}
        {% set menuImage = 'images/menus/menu-paques.jpg' %}
    {% elseif menu.theme == 'Événement' %}
        {% set menuImage = 'images/menus/menu-evenement.jpg' %}

    {% endif %}
    <a href="{{ path('app_menu') }}" class="vg-back">← Retour aux menus</a>
    <article class="vg-menu-layout">
        <div>
            <img src="{{ asset(menuImage) }}" alt="Présentation du menu {{ menu.title }}" class="vg-menu-image">
            <h2 class="mt-4">Composition du menu</h2>
            <div class="vg-dishes">
                {% for dish in menu.dishes %}
                    <section class="vg-dish">
                        <h3 class="h5">{{ dish.name }}</h3>
                        <p>Type : {{ dish.type }}</p>
                        {% if dish.description %}<p>{{ dish.description }}</p>{% endif %}
                        <p>Allergènes :
                            {% for allergen in dish.allergens %}
                                {{ allergen.name }}{{ not loop.last ? ', ' : '' }}
                            {% else %}
                                aucun allergène renseigné
                            {% endfor %}
                        </p>
                    </section>
                {% else %}
                    <p>Aucun plat n’est associé à ce menu.</p>
                {% endfor %}
            </div>
        </div>
        <div>
            <h1>{{ menu.title }}</h1>
            <p>{{ menu.description }}</p>
            <p>Thème : {{ menu.theme ?: 'Non renseigné' }}</p>
            <p>Régime : {{ menu.diet ?: 'Non renseigné' }}</p>
            <p class="vg-unit-price">{{ menu.basePrice|number_format(2, ',', ' ') }} € / personne</p>
            <p>Minimum : {{ menu.minimumPersons }} personnes</p>
            {% if menu.conditionText %}<p>Conditions : {{ menu.conditionText }}</p>{% endif %}
            <p>Stock disponible : {{ menu.stockAvailable ?? 'Non renseigné' }}</p>
            <section class="vg-preorder">
                <h2 class="h4">Avant de commander</h2>
                <p>À partir de {{ (menu.basePrice * menu.minimumPersons)|number_format(2, ',', ' ') }} € pour {{ menu.minimumPersons }} personnes, hors livraison.</p>
                <p>10 % de remise sur les menus dès {{ menu.minimumPersons + 5 }} personnes.</p>
                <p>Livraison gratuite à Bordeaux. Ailleurs : 5 € + 0,59 €/km selon le calcul de distance actuel.</p>
                <a href="{{ path('app_order_new', {id: menu.id}) }}" class="btn vg-order-button" {% if is_granted('ROLE_USER') %}data-order-open aria-haspopup="dialog" aria-controls="order-modal"{% endif %}>Commander ce menu</a>
            </section>
        </div>
    </article>
    {% if is_granted('ROLE_USER') %}
        <div class="modal fade" id="order-modal" tabindex="-1" aria-labelledby="order-modal-title" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content vg-modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h4" id="order-modal-title">Commander {{ menu.title }}</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer la commande"></button>
                    </div>
                    <div class="modal-body" data-order-modal-body></div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/order-workflow.js') }}" defer></script>
{% endblock %}
