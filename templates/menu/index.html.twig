{% extends 'base.html.twig' %}

{% block title %}Menus - Vite & Gourmand{% endblock %}

{% block body %}

<div class="container"
    id="menu-catalog"
    data-api-url="{{ app.request.baseUrl ~ '/api/menus' }}"
    data-image-base="{{ asset('images/menus/') }}"
>

    <header class="page-heading mb-5">
        <h1>Nos menus</h1>
        <p class="text-muted">
            Découvrez une sélection de menus proposés par Vite & Gourmand.
        </p>
    </header>

    <div class="row g-4 align-items-start">

        {# Filtres à gauche #}
        <aside class="col-12 col-lg-3">
            <div class="filters-sidebar">

                <div class="filters-header">
                    <h2>Filtres</h2>

                    <button
                        type="button"
                        id="reset-filters"
                        class="reset-filters"
                    >
                        Réinitialiser
                    </button>
                </div>

                <div class="filter-group">
                    <label for="filter-max-price" class="form-label">
                        Prix max / pers.
                    </label>

                    <input
                        type="number"
                        id="filter-max-price"
                        class="form-control"
                        min="0"
                        step="1"
                        placeholder="Ex : 25"
                    >
                </div>

                <div class="filter-group">
                    <label for="filter-min-price" class="form-label">
                        Prix min / pers.
                    </label>

                    <input
                        type="number"
                        id="filter-min-price"
                        class="form-control"
                        min="0"
                        step="1"
                        placeholder="Ex : 15"
                    >
                </div>

                <div class="filter-group">
                    <label for="filter-theme" class="form-label">
                        Thème
                    </label>

                    <select id="filter-theme" class="form-select">
                        <option value="">Tous</option>
                        <option value="Noël">Noël</option>
                        <option value="Pâques">Pâques</option>
                        <option value="Classique">Classique</option>
                        <option value="Événement">Événement</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label for="filter-diet" class="form-label">
                        Régime alimentaire
                    </label>

                    <select id="filter-diet" class="form-select">
                        <option value="">Tous</option>
                        <option value="Classique">Classique</option>
                        <option value="Végétarien">Végétarien</option>
                        <option value="Vegan">Vegan</option>
                        <option value="Sans gluten">Sans gluten</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label for="filter-persons" class="form-label">
                        Nombre de personnes de votre groupe
                    </label>

                    <input
                        type="number"
                        id="filter-persons"
                        class="form-control"
                        min="1"
                        step="1"
                        placeholder="Ex : 4"
                    >
                </div>
            </div>
        </aside>

        {# Résultats à droite #}
        <section class="col-12 col-lg-9" aria-labelledby="menus-title">

            <div class="menus-results-header">
                <h2 id="menus-title">
                    <span id="menus-count">{{ menus|length }}</span>
                    menu(s) trouvé(s)
                </h2>
            </div>

            <p
                id="menus-status"
                class="text-muted"
                role="status"
                aria-live="polite"
                aria-atomic="true"
            ></p>

            <div 
                class="row g-4" 
                id="menus-list" 
                aria-busy="false"
            >

                {% for menu in menus %}
                    {% set menuImage = 'images/menus/menu-evenement.jpg' %}

                    {% if menu.theme == 'Noël' %}
                        {% set menuImage = 'images/menus/menu-noel.jpg' %}
                    {% elseif menu.theme == 'Pâques' %}
                        {% set menuImage = 'images/menus/menu-paques.jpg' %}
                    {% endif %}

                    <div
                        class="col-12 col-md-6 menu-item"
                        data-price="{{ menu.basePrice }}"
                        data-theme="{{ menu.theme ?? '' }}"
                        data-diet="{{ menu.diet ?? '' }}"
                        data-persons="{{ menu.minimumPersons }}"
                    >
                        <article class="card menu-card h-100">

                            <img
                                src="{{ asset(menuImage) }}"
                                class="card-img-top"
                                alt="{{ menu.title }}"
                                loading="lazy"
                            >

                            <div class="card-body">
                                <h3 class="card-title">
                                    {{ menu.title }}
                                </h3>

                                <p class="card-text">
                                    {{ menu.description }}
                                </p>

                                <p class="mb-1">
                                    <strong>Thème :</strong>
                                    {{ menu.theme ?: 'Non renseigné' }}
                                </p>

                                <p class="mb-1">
                                    <strong>Régime :</strong>
                                    {{ menu.diet ?: 'Non renseigné' }}
                                </p>

                                <p class="mb-1">
                                    <strong>Prix minimum :</strong>
                                    {{ menu.basePrice|number_format(2, ',', ' ') }} €
                                </p>

                                <p class="mb-3">
                                    <strong>Nombre minimum :</strong>
                                    {{ menu.minimumPersons }} personnes
                                </p>

                                <a
                                    href="{{ path('app_menu_show', { id: menu.id }) }}"
                                    class="btn btn-primary mt-auto"
                                >
                                    Voir le détail
                                </a>
                            </div>
                        </article>
                    </div>

                {% else %}
                    <div class="col-12">
                        <div class="alert alert-info">
                            Aucun menu n’est disponible pour le moment.
                        </div>
                    </div>
                {% endfor %}

            </div>

            <div
                id="no-results"
                class="alert alert-warning mt-4 d-none"
                role="status"
            >
                Aucun menu ne correspond aux filtres sélectionnés.
            </div>
        </section>

        {# Modèle utilisé par menu-filters.js pour les résultats de l'API. #}
        <template id="menu-card-template">
            <div class="col-12 col-md-6 menu-item">
                <article class="card menu-card h-100">

                    <img
                        src="{{ asset('images/menus/menu-evenement.jpg') }}"
                        class="card-img-top"
                        alt=""
                        loading="lazy"
                        data-field="image"
                    >

                    <div class="card-body">
                        <h3 class="card-title" data-field="title"></h3>

                        <p class="card-text" data-field="description"></p>

                        <p class="mb-1">
                            <strong>Thème :</strong>
                            <span data-field="theme"></span>
                        </p>

                        <p class="mb-1">
                            <strong>Régime :</strong>
                            <span data-field="diet"></span>
                        </p>

                        <p class="mb-1">
                            <strong>Prix minimum :</strong>
                            <span data-field="price"></span>
                        </p>

                        <p class="mb-3">
                            <strong>Nombre minimum :</strong>
                            <span data-field="persons"></span>
                        </p>

                        <a
                            href="#"
                            class="btn btn-primary mt-auto"
                            data-field="link"
                        >
                            Voir le détail
                        </a>
                    </div>

                </article>
            </div>
        </template>

    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script
        src="{{ asset('js/menu-filters.js') }}"
        defer
    ></script>
{% endblock %}


