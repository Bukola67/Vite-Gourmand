{% extends 'base.html.twig' %}

{% block title %}Détail de la commande{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Détail de la commande #{{ order.id }}</h1>

    <a href="{{ path('app_user_space') }}" class="btn btn-secondary mb-4">
        Retour à mes commandes
    </a>

    <div class="card">
        <div class="card-body">
            <h2 class="h4 mb-3">Informations de la commande</h2>

            <p><strong>Menu :</strong> {{ order.menu.title }}</p>
            <p><strong>Statut :</strong> {{ order.status }}</p>
            <p><strong>Date de commande :</strong> {{ order.createdAt ? order.createdAt|date('d/m/Y H:i') : '' }}</p>

            <hr>

            <h2 class="h4 mb-3">Prestation</h2>

            <p><strong>Date de livraison :</strong> {{ order.deliveryDate ? order.deliveryDate|date('d/m/Y') : '' }}</p>
            <p><strong>Heure de livraison :</strong> {{ order.deliveryTime ? order.deliveryTime|date('H:i') : '' }}</p>
            <p><strong>Lieu :</strong> {{ order.deliveryPlace }}</p>
            <p><strong>Adresse :</strong> {{ order.deliveryAddress }}</p>
            <p><strong>Code postal :</strong> {{ order.deliveryPostalCode }}</p>
            <p><strong>Ville :</strong> {{ order.deliveryCity }}</p>
            <p><strong>Nombre de personnes :</strong> {{ order.personCount }}</p>

            <hr>

            <h2 class="h4 mb-3">Tarification</h2>

            <p><strong>Prix menu :</strong> {{ order.menuPrice ?? '0.00' }} €</p>
            <p><strong>Prix livraison :</strong> {{ order.deliveryPrice ?? '0.00' }} €</p>
            <p><strong>Remise :</strong> {{ order.discountAmount ?? '0.00' }} €</p>
            <p><strong>Prix total :</strong> {{ order.totalPrice }} €</p>

            <hr>

            <h2 class="h4 mb-3">Coordonnées client</h2>

            <p><strong>Prénom :</strong> {{ order.customerFirstName }}</p>
            <p><strong>Nom :</strong> {{ order.customerLastName }}</p>
            <p><strong>Email :</strong> {{ order.customerEmail }}</p>
            <p><strong>Téléphone :</strong> {{ order.customerPhone }}</p>

            {% if order.cancelReason %}
                <hr>
                <h2 class="h4 mb-3">Annulation</h2>
                <p><strong>Motif :</strong> {{ order.cancelReason }}</p>
            {% endif %}

            {% if order.status != 'acceptee' %}
                <form method="post" action="{{ path('app_user_order_cancel', {id: order.id}) }}" onsubmit="return confirm('Voulez-vous vraiment annuler cette commande ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_order_' ~ order.id) }}">
                    <button type="submit" class="btn btn-danger mt-3">
                        Annuler la commande
                    </button>
                </form>
            {% endif %}

            <hr>

            <h2 class="h4 mb-3">Historique des statuts</h2>

            {% if order.orderStatusHistories|length > 0 %}
                <ul class="list-group">
                    {% for history in order.orderStatusHistories %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ history.status }}</span>
                            <span>{{ history.changedAt ? history.changedAt|date('d/m/Y H:i') : '' }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p>Aucun historique disponible pour le moment.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}