{% extends 'base.html.twig' %}

{% block title %}Laisser un avis{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <a href="{{ path('app_user_order_show', { id: order.id }) }}" class="btn btn-outline-secondary">
                    ← Retour à la commande
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3">Laisser un avis</h1>

                    <p class="text-muted mb-4">
                        Vous pouvez donner une note de 1 à 5 et laisser un commentaire pour votre commande.
                    </p>

                    <div class="mb-4 p-3 bg-light rounded">
                        <h2 class="h5 mb-2">Commande n°{{ order.id }}</h2>
                        <p class="mb-1"><strong>Statut :</strong> {{ order.status }}</p>
                        {% if order.menu is defined and order.menu %}
                            <p class="mb-1"><strong>Menu :</strong> {{ order.menu.title }}</p>
                        {% endif %}
                        {% if order.eventDate is defined and order.eventDate %}
                            <p class="mb-0"><strong>Date de prestation :</strong> {{ order.eventDate|date('d/m/Y') }}</p>
                        {% endif %}
                    </div>

                    {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_label(form.rating) }}
                            {{ form_widget(form.rating) }}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.rating) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.comment) }}
                            {{ form_widget(form.comment) }}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.comment) }}
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                Envoyer mon avis
                            </button>

                            <a href="{{ path('app_user_order_show', { id: order.id }) }}" class="btn btn-outline-secondary">
                                Annuler
                            </a>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}