<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Vite & Gourmand{% endblock %}</title>

        {% block stylesheets %}
            <link
                href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
                rel="stylesheet"
            >

            <link
                 href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Poppins:wght@400;500;600;700&display=swap"
                 rel="stylesheet"
            >

            <link rel="stylesheet" href="{{ asset('css/customer-space.css') }}">

            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
            <link rel="stylesheet" href="{{ asset('css/home-design.css') }}">
        {% endblock %}
    </head>
    <body>

        <nav class="navbar navbar-expand-lg shadow-sm">
                <div class="container">
                    <a class="navbar-brand vg-brand" href="{{ path('app_home') }}">
                        <span class="vg-brand__mark" aria-hidden="true">
                            <img
                                src="{{ asset('images/logo-vg.png') }}"
                                alt=""
                                width="48"
                                height="48"
                            >
                        </span>

                        <span class="vg-brand__name">Vite &amp; Gourmand</span>
                    </a>

                    <button
                        class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Afficher la navigation"
                    >
                        <span class="navbar-toggler-icon"></span>
                    </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}"
                               href="{{ path('app_home') }}">
                                Accueil
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') == 'app_menu' ? 'active' : '' }}"
                               href="{{ path('app_menu') }}">
                                Menus
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') == 'app_contact' ? 'active' : '' }}"
                               href="{{ path('app_contact') }}">
                                Contact
                            </a>
                        </li>

                        {% if app.user %}
                        
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="{{ path('app_user_space') }}#orders-title"
                                >
                                    Mes commandes
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link {{ app.request.attributes.get('_route') == 'app_user_space' ? 'active' : '' }}"
                                   href="{{ path('app_user_space') }}">
                                    Mon compte
                                </a>
                            </li>

                            {% if is_granted('ROLE_EMPLOYEE') or is_granted('ROLE_ADMIN') %}
                                <li class="nav-item">
                                    <a class="nav-link {{ app.request.attributes.get('_route') == 'app_employee_orders' ? 'active' : '' }}"
                                       href="{{ path('app_employee_orders') }}">
                                        Espace employé
                                    </a>
                                </li>
                            {% endif %}

                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item">
                                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_admin_' ? 'active' : '' }}"
                                       href="{{ path('app_admin_index') }}">
                                        Espace admin
                                    </a>
                                </li>
                            {% endif %}

                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_logout') }}">
                                    Déconnexion
                                </a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a
                                    class="nav-link {{ app.request.attributes.get('_route') == 'app_login' ? 'active' : '' }}"
                                    href="{{ path('app_login') }}"
                                >
                                    Connexion
                                </a>
                            </li>

                            <li class="nav-item">
                                <a
                                    class="btn btn-primary vg-register"
                                    href="{{ path('app_register') }}"
                                >
                                    Inscription
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <main class="{% block main_class %}container py-5{% endblock %}">
            {% block body %}{% endblock %}
        </main>

        <footer class="vg-footer">
            <div class="container">
                <div class="vg-footer__top">
                    <div class="vg-footer__identity">
                        <a
                            class="vg-footer__brand"
                            href="{{ path('app_home') }}"
                        >
                            <img
                                src="{{ asset('images/logo-vg.png') }}"
                                alt=""
                                width="48"
                                height="48"
                                class="vg-footer__logo"
                            >

                            <span>Vite &amp; Gourmand</span>
                        </a>

                        <p class="vg-footer__description">
                            Service traiteur à Bordeaux
                        </p>
                    </div>

                    <p class="vg-footer__hours">
                        Horaires : lundi au dimanche,
                        11h–14h et 18h30–22h
                    </p>
                </div>

                <div class="vg-footer__bottom">
                    <nav aria-label="Informations légales">
                        <a href="{{ path('app_legal_mentions') }}">
                            Mentions légales
                        </a>

                        <a href="{{ path('app_legal_cgv') }}">
                            CGV
                        </a>
                    </nav>
                </div>
            </div>
        </footer>

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% endblock %}
    </body>
</html>