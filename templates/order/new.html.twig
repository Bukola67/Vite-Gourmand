{% extends 'base.html.twig' %}
{% block title %}Commander {{ menu.title }} — Vite & Gourmand{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/order-workflow.css') }}">
{% endblock %}
{% block body %}
    <a href="{{ path('app_menu_show', {id: menu.id}) }}" class="vg-back">← Retour au menu</a>
    <article class="vg-order-page">
        <h1>Commander {{ menu.title }}</h1>
        {% include 'order/_form.html.twig' %}
    </article>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/order-workflow.js') }}" defer></script>
{% endblock %}
